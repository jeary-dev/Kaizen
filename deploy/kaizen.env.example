# Copy to deploy/kaizen.env (gitignored) to override defaults. Every setting is optional.

# The public address of the editor, used in links and the CSP.
KAIZEN_PUBLIC_URL=https://edit.jeary.dev

# Session lifetime in seconds: what the plugin asks for is clamped to [60, max].
#KAIZEN_DEFAULT_TTL_SECONDS=3600
#KAIZEN_MAX_TTL_SECONDS=21600

# Request size limits in bytes (encrypted, compressed payloads).
#KAIZEN_MAX_UPLOAD_BYTES=8388608
#KAIZEN_MAX_CHANGES_BYTES=8388608

# How often expired sessions are deleted, in seconds.
#KAIZEN_SWEEP_INTERVAL_SECONDS=300

# Where the client IP comes from (rate limiting only): cf-connecting-ip, x-real-ip,
# x-forwarded-for or none. Only trust a header that your proxy always overwrites.
#KAIZEN_CLIENT_IP_HEADER=cf-connecting-ip
