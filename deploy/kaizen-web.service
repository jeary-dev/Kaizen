# Kaizen web app without Docker, as a hardened systemd service on 127.0.0.1:3100.
#
# Install (see docs/deploy.md, "Without Docker"):
#   deploy/build-standalone.sh /opt/kaizen/web
#   sudo cp deploy/kaizen-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now kaizen-web
#
# The database lives in /var/lib/kaizen (StateDirectory), owned by a throwaway system user.

[Unit]
Description=Kaizen config editor (web)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/kaizen/web
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3

Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3100
Environment=KAIZEN_DB_PATH=/var/lib/kaizen/kaizen.db
Environment=KAIZEN_PUBLIC_URL=https://edit.jeary.dev
# Trusted only because the app listens on 127.0.0.1 behind cloudflared. See docs/security.md.
Environment=KAIZEN_CLIENT_IP_HEADER=cf-connecting-ip
EnvironmentFile=-/etc/kaizen/kaizen.env

DynamicUser=yes
StateDirectory=kaizen
StateDirectoryMode=0700
CacheDirectory=kaizen
# Next.js writes its cache next to the server; point it at a writable place.
BindPaths=/var/cache/kaizen:/opt/kaizen/web/.next/cache

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077
MemoryMax=512M

[Install]
WantedBy=multi-user.target
